# STATE.a2ml — Svalinn project state (MEASURED, not self-reported)
[metadata]
project = "svalinn"
version = "0.1.0"
last-updated = "2026-07-28"
status = "active"
session = "measured audit — 2026-07-28"
measurement-method = "file reads, builds executed, tests run; see STATUS.md"

[project-context]
name = "Svalinn"
purpose = """Edge gateway — validates container operation requests, enforces policy, delegates to Vordr"""
completion-percentage = 15
completion-basis = "measured 2026-07-28; supersedes earlier self-reported figure"

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[verified-working]
items = [
  """`tools/mvp/svalinn_gateway.ts` — 777 lines, `deno check` passes clean. This is what `deno task start` actually runs, and it is the ONLY working gateway.""",
  """`tools/mvp/svalinn-gate` Rust — 425 lines, `cargo check` passes.""",
  """**`ci.yml` is one of only four genuinely enforced gates in the ecosystem** — `deno lint`, `deno fmt --check`, `deno check`, `deno test`, with `build` gated on `needs: [...]`.""",
  """`svalinn_gateway.ts:204` `new Deno.Command("vordr", ...)` is the ONLY integration in the entire six-repo ecosystem that actually works.""",
  """`audits/` contains one substantive real analysis (2026-05-26, 4 PA022 JWT findings).""",
]

[blockers-and-issues]
issues = [
  """**`src/` is 32 `.affine` files (5,956 lines) in a language with no compiler available.** Headers read `Generated by tools/res-to-affine ... (--translate, Phase 3)` and `PARTIAL PORT ... every other form is left as a TODO island`. All 32 retain `/* ORIGINAL RESCRIPT — retained for reference */` blocks; 15 carry `TODO: port the remaining forms`; 32 carry unresolved `MIGRATE:` markers. `GatewayServer.affine` translated exactly one struct and stopped.""",
  """**The 57 passing tests import ZERO lines of svalinn.** Every suite defines an inline reimplementation and says so — 'a policy evaluator that MIRRORS PolicyEvaluator.res'. They mirror `.res` files that no longer exist (0 `.res` files in the repo). 57 green tests certify nothing.""",
  """The README marks Edge Gateway, Vordr Integration, Policy Engine, Authentication and svalinn-compose all 'Complete'. All five are false.""",
  """`EVALUATION-REPORT.adoc` mandates 'A rating without evidence is invalid' — and `evidence/` contains only `.gitkeep`. Its 'Onboarding: Strong' rating cites `vordr/src/cli/doctor.rs`, a file in a DIFFERENT repository.""",
  """`PROOF-NEEDS.md` states 'Languages: ReScript' and cites `src/abi/*.idr` and '20+ Obj.magic calls'. Reality: 0 `.res`, 0 `.idr`, no `src/abi/`.""",
  """Four workflows filter on `paths: ['vordr/**']` — **`svalinn/vordr/` does not exist**, so they can never trigger.""",
  """`ecosystem.yaml` lists only 3 of the 6 repos (omits stapeln, selur, rokur); quickstart paths point at `~/Documents/hyperpolymath-repos/`, which does not exist; line 2 is a `//` C++ comment in a YAML file.""",
  """`svalinn-compose` is `ComposeOrchestrator.affine` — 132 uncompilable lines, competing with selur's 6,503-line working compose CLI.""",
]

[critical-next-actions]
actions = [
  """RULING NEEDED (R2): run the AffineScript compiler against src/ and decide promote-MVP vs finish-port""",
  """Make the test suites import the code they claim to test""",
  """Correct the README status table — five 'Complete' entries are false""",
  """Delete or repoint the four workflows filtering on the nonexistent vordr/** path""",
  """Rewrite ecosystem.yaml to cover all six repos, or delete it""",
  """Populate evidence/ or stop citing it in EVALUATION-REPORT.adoc""",
]

[ecosystem]
stack = ["stapeln", "selur", "vordr", "rokur", "cerro-torre", "svalinn"]
designer = "stapeln"
canonical-contract = "container/stapeln/ — 8-file bundle, one file per satellite"
contract-status = "NOT EMITTED BY STAPELN AND NOT CONSUMED BY ANY SATELLITE as of 2026-07-28"
runtime-chain = "svalinn(443/80) -> rokur(8081) -> app; vordr watches; cerro-torre signs; selur is network driver"

[maintenance-status]
